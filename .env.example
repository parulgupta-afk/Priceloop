# ======================
# Application
# ======================
APP_NAME=Priceloop
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Not yet implemented -- no refresh-token endpoint exists yet.
REFRESH_TOKEN_EXPIRE_DAYS=30

# ======================
# Database
# ======================
# Currently read with the plain (sync) SQLAlchemy driver -- see note below
# if you want async (postgresql+asyncpg://) instead.
DATABASE_URL=postgresql://priceloop:priceloop@postgres:5432/priceloop

# ======================
# Redis / Celery
# ======================
REDIS_URL=redis://redis:6379/0
# Optional: give Celery its own Redis DB numbers instead of sharing db 0
# with the app. Leave blank to fall back to REDIS_URL for both.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ======================
# CORS
# ======================
# Comma-separated origins the frontend is served from, or "*" for any
# (fine for local dev, NOT recommended once this is public).
CORS_ORIGINS=http://localhost:5173

# ======================
# Stripe billing
# ======================
# Blank by default -- checkout returns a clean 503 until these are real.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PROFESSIONAL=
STRIPE_PRICE_ID_ENTERPRISE=
FRONTEND_URL=http://localhost:5173

# ======================
# LLM (reserved for Phase 15 -- AI insight engine; no code reads these yet)
# ======================
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ======================
# Email (reserved for Phase 18 -- notifications; no code reads these yet)
# ======================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@priceloop.local

# ======================
# Scraping
# ======================
SCRAPER_USER_AGENT=PriceloopBot/1.0 (+https://github.com/your-username/priceloop)
SCRAPER_DEFAULT_RATE_LIMIT=1.0
SCRAPER_MAX_RETRIES=3

# ======================
# Object storage (reserved for Phase 21 -- screenshot verification; no code reads these yet)
# ======================
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=priceloop
